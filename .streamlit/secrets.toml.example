# Copy this to your Streamlit Cloud app's Secrets (Settings → Secrets).
# Do NOT commit a real secrets.toml — it is gitignored.

# Optional: require a password to open the app (confidential sharing).
app_password = "choose-a-strong-password"

# Optional: enable the "Ask Claude" tab for everyone (uses YOUR Anthropic account — costs apply).
# Leave this out and each user pastes their own key instead.
# ANTHROPIC_API_KEY = "sk-ant-..."
